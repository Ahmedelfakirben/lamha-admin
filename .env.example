# Supabase Backend
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-url.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_ADMIN_EMAIL=admin@lamhastudios.ma

# Google Drive OAuth 2.0 (Conexión 1-Clic desde el Panel de Administración)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Servidor de Producción
NODE_ENV=production
PORT=3000

# Evolution API v2 (WhatsApp Pasarela y Automatización)
EVOLUTION_API_URL=https://wa-api.elfakir.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=lam7astudio
