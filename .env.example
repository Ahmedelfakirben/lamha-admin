# Supabase Backend
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-url.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_ADMIN_EMAIL=admin@lamhastudios.ma

# NAS / Router FTP Storage (Opcional en Cloud)
LAMHA_FTP_HOST=192.168.11.1
LAMHA_FTP_USER=admin
LAMHA_FTP_PASSWORD=your_nas_password
LAMHA_FTP_BASE_DIR=/usb1_1/Lamha-Storage

# Google Drive API & OAuth
GDRIVE_CLIENT_EMAIL=your-service-account@iam.gserviceaccount.com
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GDRIVE_PARENT_FOLDER_ID=your_gdrive_folder_id

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Servidor de Producción
NODE_ENV=production
PORT=3000
